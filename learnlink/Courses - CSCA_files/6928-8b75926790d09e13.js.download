uestions:80,points:"0-100 Points",pointsZh:"0-100 分",iconBg:"bg-yellow-50",pointsBg:"bg-yellow-50",pointsText:"text-yellow-700"},{name:"Chinese (Science)",nameZh:"中文（理科）",lang:"Chinese only",langZh:"仅中文",icon:"\uD83D\uDD2C",minutes:90,questions:80,points:"0-100 Points",pointsZh:"0-100 分",iconBg:"bg-red-50",pointsBg:"bg-red-50",pointsText:"text-red-700"}],examFees:[{label:"Single Subject",labelZh:"单科报名",value:"\xa5450 CNY"},{label:"Two or More Subjects",labelZh:"两科及以上",value:"\xa5700 CNY"},{label:"Note",labelZh:"说明",value:"Fees in Chinese Yuan",valueZh:"费用以人民币计价"}],examTimeSchedule:[{subject:"Chinese (Major)",subjectZh:"中文（主修）",time:"12:00 - 13:30"},{subject:"Physics",subjectZh:"物理",time:"15:00 - 16:00"},{subject:"Mathematics",subjectZh:"数学",time:"18:00 - 19:00"},{subject:"Chemistry",subjectZh:"化学",time:"20:30 - 21:30"}],syllabusSubjects:[{name:"Chinese (Arts)",nameZh:"中文（文科）",slug:"chinese-arts",icon:"\uD83D\uDCD7",color:"bg-[#3D7A5D]",topics:["Reading","Writing","Listening","Vocabulary"],topicsZh:["阅读","写作","听力","词汇"]},{name:"Chinese (Science)",nameZh:"中文（理科）",slug:"chinese-science",icon:"\uD83D\uDCD5",color:"bg-[#8E2430]",topics:["Reading","Vocabulary","Grammar","Writing"],topicsZh:["阅读","词汇","语法","写作"]},{name:"Mathematics",nameZh:"数学",slug:"mathematics",icon:"\uD83D\uDCD8",color:"bg-[#1E62B5]",topics:["Reading","Writing","Listening","Listening"],topicsZh:["代数","函数","几何","微积分"]},{name:"Physics",nameZh:"物理",slug:"physics",icon:"\uD83D\uDCD9",color:"bg-[#D3602D]",topics:["Mechanics","Electricity & Magnetism","Optics","Modern Physics"],topicsZh:["力学","电磁学","光学","现代物理"]},{name:"Chemistry",nameZh:"化学",slug:"chemistry",icon:"\uD83D\uDCD2",color:"bg-[#6A57A1]",topics:["Organic Chemistry","Inorganic Chemistry","Physical Chemistry","Chemical Reactions"],topicsZh:["有机化学","无机化学","物理化学","化学反应"]}],importantNotes:["Online exams require camera and microphone for proctoring","You must have valid ID (passport)","Scores are valid for 2 years","Math, Physics, Chemistry can use calculators","You can take the exam multiple times to improve your score"],importantNotesZh:["线上考试需要开启摄像头和麦克风进行监考","考试时必须携带有效身份证件（护照）","考试成绩有效期为 2 年","数学、物理、化学科目允许使用计算器","你可以多次参加考试以提升成绩"],faqItems:[{q:"What is the CSCA exam ?",qZh:"什么是 CSCA 考试？",a:"The CSCA exam (China Standardized College Admission) is a standardized exam for international students applying to Chinese universities. The exam covers mathematics, physics, chemistry, and Chinese subjects, and it is the main reference for Chinese university admissions.",aZh:"CSCA（China Standardized College Admission）是面向申请中国高校国际学生的标准化考试，覆盖数学、物理、化学和中文等科目，是中国高校录取的重要参考。"},{q:"When is the next CSCA exam in 2026 ?",qZh:"2026 年下一场 CSCA 考试是什么时候？",a:"The next CSCA exam is scheduled for March 15, 2026. Registration opens on February 5, 2026.",aZh:"下一场 CSCA 考试计划于 2026 年 3 月 15 日举行，报名将于 2026 年 2 月 5 日开启。"},{q:"How much does the CSCA exam cost ?",qZh:"CSCA 考试费用是多少？",a:"The exam fee is \xa5450 CNY for a single subject, or \xa5700 CNY for two or more subjects.",aZh:"单科报名费用为 \xa5450，两科及以上报名费用为 \xa5700。"},{q:"Which subjects should I take ?",qZh:"我应该报考哪些科目？",a:"It depends on your intended major. Science and engineering students typically take Mathematics, Physics, and Chemistry. Arts students take Chinese (Arts Stream) along with other subjects based on university requirements.",aZh:"这取决于你的目标专业。理工类学生通常报考数学、物理和化学；文科方向学生则报考中文（文科方向）以及高校要求的其他科目。"},{q:"Can I use English for the exam ?",qZh:"考试可以使用英文吗？",a:"Mathematics, Physics, and Chemistry can be taken in either Chinese or English. However, Chinese subjects must be completed in Chinese only.",aZh:"数学、物理和化学可以选择中文或英文作答，但中文科目只能使用中文作答。"}]},h={ui:{sidebarTabs:[{key:"achievements",label:"Achievements"},{key:"diagnosis",label:"AI Diagnosis"},{key:"wrong",label:"Wrong Questions"},{key:"purchases",label:"Purchases"}],actions:{subscribe:"Subscribe +",logout:"Log Out",deleteAccount:"Delete Account"},wrongQuestionSubjects:["Mathematics","Physics","Chemistry","Stats Chinese","Humanities Chinese"],purchaseTabs:[{key:"courses",label:"Courses"},{key:"exam-papers",label:"Exam Papers"},{key:"matter-at-pacific",label:"Matter at Pacific"}],sections:{achievements:"My Achievements",diagnosis:"My Knowledge Point Diagnosis",diagnosisBadge:"AI Analysis",weakPoints:"Weak Points",recommendation:"AI Recommendation",practiceNow:"Practice Now",wrongQuestions:"My Wrong Questions Collection From Practice Center",mistakesSuffix:"mistakes",totalQuestionsPrefix:"Total:",totalQuestionsSuffix:"questions",reviewAgain:"Review Again",yourAnswer:"Your Answer",correctAnswer:"Correct Answer",purchaseRecords:"My Purchase Records",purchasedPrefix:"Purchased:"}},metadata:{title:"My Study - LearnLink",description:"Manage your LearnLink progress, achievements, purchases, and wrong-question review in one place."}}},9473:(e,a,i)=>{i.d(a,{eu:()=>s,jz:()=>n,qA:()=>o});let t={en:"en-US",zh:"zh-CN",ja:"ja-JP",ko:"ko-KR",fr:"fr-FR"},s="2026-03-23T09:00:00";function o(e){let a=new Date(null!=e?e:s);return Number.isNaN(a.getTime())?new Date(s):a}function n(e,a){var i;return new Intl.DateTimeFormat(null!=(i=t[a])?i:"en-US",{month:"long",day:"numeric"}).format(e)}}}]);