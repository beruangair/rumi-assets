."}},resetPassword:{title:"Reset Password",subtitle:"Enter your email to receive a password reset link",email:"Email",emailPlaceholder:"Enter your email",submit:"Send Reset Link",successMessage:"If an account exists with that email, you will receive a password reset link shortly.",backToLogin:"Back to sign in",errors:{emailRequired:"Email is required",emailInvalid:"Please enter a valid email address",generic:"Failed to send reset link. Please try again."}}},u={hero:{countdownPrefix:"Upcoming CSCA Exam is on",countdownPrefixZh:"下一场 CSCA 考试时间",countdownDaysSuffix:"days left",countdownDaysSuffixZh:"天",titlePrefix:"Everything You Need to",titlePrefixZh:"你需要了解的",titleHighlight:"Know",titleHighlightZh:"考试信息",subtitle:"A comprehensive guide to help you prepare for and succeed on exam day",subtitleZh:"一份完整的考试指南，帮助你高效备考并顺利应对考试日。",registerCta:"Register for CSCA Exam",registerCtaZh:"报名参加 CSCA 考试",startLearningCta:"\uD83C\uDF93 Start Learning",startLearningCtaZh:"\uD83C\uDF93 开始学习",viewCoursesCta:"\uD83D\uDCF9 View Courses",viewCoursesCtaZh:"\uD83D\uDCF9 查看课程"},sections:{examScheduleCardTitle:"Exam Schedule",examScheduleCardTitleZh:"考试安排",examFormatCardTitle:"Exam Format",examFormatCardTitleZh:"考试形式",whatIsExamTitlePrefix:"What is the",whatIsExamTitlePrefixZh:"什么是",whatIsExamTitleHighlight:"CSCA Exam",whatIsExamTitleHighlightZh:"CSCA 考试",whatIsExamParagraphs:["The CSCA exam (China Standardized College Admission) is a standardized exam for international students applying to Chinese universities. The exam covers mathematics, physics, chemistry, and Chinese subjects, and it is the main reference for Chinese university admissions.","For students applying to science and engineering programs at Chinese universities, the CSCA exam is one of the key assessment systems. Currently, it is recognized by over 300 Chinese universities and serves as an important admission standard for international students."],whatIsExamParagraphsZh:["CSCA（China Standardized College Admission）考试是面向申请中国高校国际学生的标准化考试，覆盖数学、物理、化学及中文等科目，是中国高校录取的重要参考之一。","对于申请中国高校理工类专业的学生来说，CSCA 是核心评估体系之一。目前已有 300 多所中国高校认可该成绩，并将其作为国际学生入学的重要标准。"],scheduleTitle:"Exam Schedule & Format",scheduleTitleZh:"考试安排与形式",scheduleSubtitle:"Key information about exam dates and structure",scheduleSubtitleZh:"快速了解考试日期、报名时间与考试结构",subjectsTitle:"Exam Subjects",subjectsTitleZh:"考试科目",subjectsSubtitle:"5 test subjects with detailed information",subjectsSubtitleZh:"共 5 个考试科目，附详细说明",minutesLabel:"minutes",minutesLabelZh:"分钟",questionsLabel:"questions",questionsLabelZh:"题",feesTitle:"Exam Fees",feesTitleZh:"考试费用",timeScheduleTitle:"March 15 Exam Schedule (Beijing Time)",timeScheduleTitleZh:"3 月 15 日考试时间表（北京时间）",syllabusTitlePrefix:"CSCA Exam",syllabusTitlePrefixZh:"CSCA 考试",syllabusTitleHighlight:"Syllabus Overview",syllabusTitleHighlightZh:"大纲概览",syllabusSubtitle:"CSCA exam covers four major subjects",syllabusSubtitleZh:"CSCA 覆盖四大核心学科方向",viewMore:"View More",viewMoreZh:"查看详情",importantNotesTitle:"Important Notes",importantNotesTitleZh:"重要提醒",faqTitle:"Frequently Asked Questions",faqTitleZh:"常见问题",faqSubtitle:"Common questions about the CSCA exam",faqSubtitleZh:"关于 CSCA 考试的常见问题解答",bottomCtaTitle:"Practice with Real CSCA Mock Exams",bottomCtaTitleZh:"使用真实风格的 CSCA 模拟卷进行练习",bottomCtaSubtitle:"Get realistic CSCA mock exams to test your knowledge. All questions come with detailed explanations.",bottomCtaSubtitleZh:"通过高仿真的 CSCA 模拟卷检测学习效果，所有题目均附带详细解析。",bottomCtaButtons:{courses:"\uD83C\uDF93 Get Course →",coursesZh:"\uD83C\uDF93 获取课程 →",mockExams:"\uD83D\uDCDD Get Mock Exams →",mockExamsZh:"\uD83D\uDCDD 获取模拟卷 →"},bottomCtaBadges:[{icon:"\uD83D\uDCDD",title:"Exam Coverage",titleZh:"覆盖完整考点",desc:"All subjects fully covered",descZh:"覆盖所有核心科目"},{icon:"\uD83D\uDCCA",title:"Detailed Analysis",titleZh:"详细解析",desc:"Step-by-step solutions",descZh:"提供分步讲解与分析"},{icon:"✓",title:"All Subjects",titleZh:"全科覆盖",desc:"Math, Physics, Chemistry, Chinese(Art/Stream)",descZh:"数学、物理、化学与中文（文理分流）"}]},nextExamDate:t.eu,heroStats:[{icon:"\uD83D\uDC