"我们的","servicePlansTitleHighlight":"服务套餐","servicePlansSubtitle":"从初始咨询到全程支持——选择最适合您的方案","coreServicesTitle":"核心服务","coreServicesSubtitle":"专业覆盖申请旅程中每个关键阶段","whyChooseTitlePrefix":"为什么选择","whyChooseTitleHighlight":"LearnLink","whyChooseSubtitle":"数据驱动 \xb7 深度专业 \xb7 透明可信","faqTitle":"常见问题","faqSubtitle":"关于我们申请服务的常见问题","bottomCtaTitle":"不确定从哪里开始？","bottomCtaSubtitle":"从专业咨询开始。","bottomCtaHelper":"如果您选择升级服务，已支付的费用将全额抵扣。","bottomCtaButton":"通过WhatsApp联系LearnLink"},"whoFor":[{"title":"CSCA考生","description":"已经参加或计划参加CSCA考试的学生"},{"title":"奖学金申请者","description":"希望申请政府或机构奖学金的学生"},{"title":"国际学生","description":"计划申请中国本科或硕士项目的学生"},{"title":"首次申请者","description":"首次接触中国大学申请流程的学生"}],"servicePlans":[{"name":"基础套餐","badge":"\uD83D\uDD25 推荐起步","description":"申请咨询，适合需要明确方向的学生","price":"$899","priceLabel":"一次性费用","cta":"预约咨询 →","features":["CSCA成绩竞争力分析","奖学金可行性评估","大学层级推荐","后续步骤路线图"]},{"name":"策略套餐","badge":"\uD83D\uDE80 最受欢迎","description":"高级评估与选校咨询","price":"$2,999","priceLabel":"一次性费用","cta":"预约高级评估 →","features":["提前/常规/保底录取策略","奖学金竞争力分析","个性化选校清单与评估报告","国际项目CSCA分析"]},{"name":"全程录取套餐","badge":"⭐ 最超值","description":"完整本科申请，端到端申请支持","price":"$18,800","priceLabel":"起步价","cta":"开始全程申请 →","features":["30分钟一对一咨询","CSCA成绩范围竞争力分析","初步奖学金可行性审核","初步学校层级推荐"]}],"coreServices":[{"title":"精准选校","description":"根据您的CSCA成绩和学术背景，量身定制选校方案"},{"title":"奖学金策略","description":"分析奖学金竞争情况，设计可行的奖学金申请策略"},{"title":"申请材料","description":"编辑、构建文书逻辑，通过优化提升整体竞争力"},{"title":"全程管理","description":"指导申请提交并跟踪进度，确保高效完成"}],"whyChoose":[{"title":"我们真正了解CSCA","points":["长期研究中国高校","跨院校录取研究","真实数据驱动策略规划"]},{"title":"专业顾问团队","points":["海外学生案例经验","CSC奖学金流程熟悉","个性化规划支持"]},{"title":"透明流程与清晰定价","points":["无隐藏费用，清晰里程碑结构","明确的里程碑结构","明确的服务范围"]}],"faqs":[{"question":"什么是CSCA考试？","answer":"CSCA（中国奖学金理事会评估）考试是一项标准化测试，旨在评估国际学生在中国学习的学术准备情况。根据您的预期专业，考试涵盖数学、中文、物理和化学等科目。"},{"question":"CSCA考试费用是多少？","answer":"单科考试费为450元人民币，两科及以上为700元人民币。"},{"question":"我应该选择哪些科目？","answer":"这取决于您的预期专业。理工科学生通常选择数学、物理和化学。文科学生选择中文（文科方向）以及根据大学要求的其他科目。"},{"question":"考试可以使用英语吗？","answer":"数学、物理和化学可以选择中文或英文作答。但是，中文科目必须使用中文完成。"}]},"Common":{"loading":"加载中...","error":"出了点问题","retry":"重试","back":"返回","viewMore":"查看更多","viewAll":"查看全部","learnMore":"了解更多","getStarted":"立即开始","free":"免费","popular":"热门","new":"新","comingSoon":"即将推出","save":"保存","cancel":"取消","search":"搜索","noResults":"未找到结果","total":"合计","switchLanguage":"English"}}');var r=i(4704);let o={en:s,zh:a},n=["CSCA 大纲对齐练习","真实考试节奏模拟","资深教师团队设计"],l={Algebra:"代数",Geometry:"几何",Trigonometry:"三角函数",Calculus:"微积分","Advanced Topics":"进阶专题",Fundamentals:"基础知识","Reactions & Equilibrium":"反应与平衡","Organic Chemistry":"有机化学",Mechanics:"力学","Thermodynamics & Waves":"热学与波动","Electricity & Magnetism":"电学与磁学",Vocabulary:"词汇",Reading:"阅读",Writing:"写作","Classical Texts":"文言文","Modern Language":"现代语言"},c={algebra:{title:"代数与方程",description:"涵盖一次方程、二次方程、方程组、不等式与基础代数变形。",chapter:"代数"},functions:{title:"函数与图像",description:"学习定义域、值域、图像变换，以及多项式和有理函数的性质。",chapter:"代数"},sequences:{title:"数列与级数",description:"掌握等差、等比数列，求和公式以及基础收敛概念。",chapter:"代数"},geometry:{title:"平面几何",description:"覆盖图形、角度、全等、相似以及二维图形面积和周长。",chapter:"几何"},"solid-geometry":{title:"立体几何",description:"学习棱柱、棱锥、球体、圆柱等立体图形的体积与表面积。",chapter:"几何"},"coordinate-geometry":{title:"解析几何",description:"利用代数方法研究直线、圆与圆锥曲线等解析几何问题。",chapter:"几何"},trigonometry:{title:"三角函数",description:"包括正弦、余弦、正切、恒等变换及其在三角形中的应用。",chapter:"三角函数"},calculus:{title:"微积分基础",description:"介绍极限、导数、积分及其在典型题目中的核心应用。",chapter:"微积分"},statistics:{title:"统计与概率",description:"包含数据分析、概率规则、分布以及基础统计推断。",chapter:"微积分"},"number-theory":{title:"数论",description:"学习整除、质数、模运算与基础数论定理。",chapter:"进阶专题"},kinematics:{title:"运动学",description:"在不考虑受力的前提下，用位移、速度、加速度和时间描述运动。",chapter:"力学"},dynamics:{title:"牛顿定律与动力学",description:"运用牛顿三定律分析受力、摩擦、拉力与圆周运动。",chapter:"力学"},"energy-work":{title:"能量、功与功率",description:"掌握能量守恒、动能定理、势能与动能的相互转化。",chapter:"力学"},mechanics:{title:"力学",description:"聚焦速度、加速度、受力分析和基础机械运动问题。",chapter:"力学"},thermodynamics:{title:"热力学",description:"学习热量、温度、热力学定律和理想气体热过程。",chapter:"热学与波动"},waves:{title:"波动与声学",description:"掌握波的性质、声强、干涉、共振与多普勒效应。",chapter:"热学与波动"},optics:{title:"光学",description:"涵盖反射、折射、透镜、镜面成像与光学仪器。",chapter:"热学与波动"},electricity:{title:"电学与电路",description:"理解电荷、电流、电压、电阻以及串并联电路分析。",chapter:"电学与磁学"},magnetism:{title:"磁学与电磁感应",description:"学习磁场、带电粒子受力、电流受力与电磁感应现象。",chapter:"电学与磁学"},"atomic-structure":{title:"原子结构",description:"涵盖质子、中子、电子、电子排布和元素周期表基础。",chapter:"基础知识"},"chemical-bonds":{title:"化学键",description:"学习离子键、共价键、金属键、路易斯结构与分子构型。",chapter:"基础知识"},stoichiometry:{title:"化学计量",description:"掌握物质的量比、配平、限量试剂与产率计算。",chapter:"基础知识"},reactions:{title:"化学反应",description:"包括反应类型、氧化还原、反应速率和能量变化。",chapter:"反应与平衡"},equilibrium:{title:"化学平衡",description:"学习勒夏特列原理、平衡常数与酸碱平衡问题。",chapter:"反应与平衡"},organic:{title:"有机化学",description:"覆盖烃类、官能团、取代反应、加成反应等基础内容。",chapter:"有机化学"},"technical-terms":{title:"科技术语",description:"掌握理工科常见中文术语、概念表达与专业词汇。",chapter:"词汇"},"reading-comprehension":{title:"阅读理解",description:"训练对科技类文章、实验说明和技术材料的理解能力。",chapter:"阅读"},writing:{title:"科学写作",description:"练习用中文完成技术描述、实验报告与科学解释。",chapter:"写作"},"essay-writing":{title:"议论文写作",description:"学习中文议论文与分析性文章的结构、论证与表达。",chapter:"写作"},"classical-chinese":{title:"文言文",description:"阅读并理解文言文篇章，掌握常见语法与表达规律。",chapter:"文言文"},"modern-reading":{title:"现代文阅读",description:"训练对现代散文、文章和文学节选的理解与分析能力。",chapter:"现代语言"}};function u(e){return(null==e?void 0:e.toLowerCase().startsWith("zh"))?"zh":"en"}function d(e){return"zh"===u(e)}function p(e){return o[u(e)]}function h(e,t){var i,s;if(!d(t))return e;let a=p(t),o=function(e){let t=p(e);return{practice:t.Header.nav.practice,mockExams:t.Header.nav.mockExams,courses:t.Header.nav.courses,examGuide:t.Header.nav.examGuide,academicPathways:t.Header.nav.academicPathways,userCenter:t.Header.nav.userCenter}}(null!=t?t:"zh"),n=function(e){let t=p(e);return{about:t.Footer.columns.about.about,practice:t.Footer.columns.about.practice,courses:t.Footer.columns.about.courses,mock:t.Footer.columns.about.mock,exam:t.Footer.columns.guide.exam,partner:t.Footer.co